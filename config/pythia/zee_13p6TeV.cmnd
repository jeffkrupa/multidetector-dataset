! Pythia8 card: pp -> Z/gamma* -> e+e- at 13.6 TeV (Run 3). Process only; seed and N are CLI args.
Beams:idA = 2212
Beams:idB = 2212
Beams:eCM = 13600.
WeakSingleBoson:ffbar2gmZ = on
23:onMode = off
23:onIfAny = 11
PhaseSpace:mHatMin = 50.
Tune:pp = 14                     ! Monash 2013 (same physics tune in both experiments' inputs by construction)
! Leave long-lived particles (c*tau > 10 mm: K0S, Lambda, ...) undecayed so Geant4 decays them inside the
! detector. This is what both ATLAS (Pythia8_Base_Fragment) and CMS (pythia8CommonSettings) do in production,
! and ATLAS TestHepMC rejects events with generator vertices displaced by > 1 m.
ParticleDecays:limitTau0 = on
ParticleDecays:tau0Max = 10.
Next:numberShowEvent = 0
Print:quiet = on
