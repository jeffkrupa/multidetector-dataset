# Single source of truth for every pinned software version in this workflow.
# Change a version here, nowhere else. All run scripts source this file.

# --- Step 1: common event generation (Pythia8 -> HepMC) -----------------------
LCG_RELEASE=LCG_110                 # /cvmfs/sft.cern.ch/lcg/views/${LCG_RELEASE}/${LCG_PLATFORM}
LCG_PLATFORM=x86_64-el9-gcc14-opt   # provides Pythia 8.317, HepMC3 3.3.1, gcc 14.3

# --- Step 2a: ATLAS full simulation + reconstruction (Athena) -----------------
ATLAS_CONTAINER=/cvmfs/atlas.cern.ch/repo/containers/fs/singularity/x86_64-almalinux9
ATHENA_RELEASE=25.0.72              # /cvmfs/atlas.cern.ch/repo/sw/software/25.0/Athena/25.0.72
# geometry / conditions are set in atlas/run_atlas.sh (filled from research; see docs/ATLAS.md)

# --- Step 2b: CMS full simulation + reconstruction (CMSSW) --------------------
CMS_CONTAINER_WRAPPER=/cvmfs/cms.cern.ch/common/cmssw-el9   # apptainer wrapper -> cmssw/el9:x86_64 image
CMSSW_RELEASE=CMSSW_14_0_25   # latest 14_0_X: the only series carrying the frozen 2024 HLT menu (HLT:2024v14);
                              # 15_0_X drops it. McM Run3Summer24 GEN-SIM/DIGI/RECO used 14_0_18-21 on el8_amd64_gcc12.
SCRAM_ARCH=el9_amd64_gcc12    # el8_amd64_gcc12 (+ cmssw-el8) reproduces McM's arch exactly; el9 is the native one here
# global tag / era are set in cms/run_cms.sh (see docs/CMS.md)
